{
  "name": "site-expense-tracker-backend",
  "version": "1.0.0",
  "description": "Backend API for Site Expense Tracker - Node.js, Express, Prisma, PostgreSQL",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
